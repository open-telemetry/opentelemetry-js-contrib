{
  "analytics": false,
  "targetDefaults": {
    "compile": {
      "dependsOn": ["version:update", "^compile"],
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/test/**/*.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/tsdown.config.ts",
        "{projectRoot}/tsdown.*.config.ts",
        "{workspaceRoot}/tsdown.config.ts"
      ],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "watch": {
      "dependsOn": ["compile"]
    },
    "version:update": {
      "inputs": ["{projectRoot}/package.json"],
      "outputs": ["{projectRoot}/src/version.ts"],
      "cache": true
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint",
        "cache": true
      }
    }
  ]
}
