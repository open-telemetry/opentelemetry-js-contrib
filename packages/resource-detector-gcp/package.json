{
  "name": "@opentelemetry/resource-detector-gcp",
  "version": "0.59.0",
  "description": "OpenTelemetry SDK resource detector for GCP",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/resource-detector-gcp"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/resource-detector-gcp",
    "prepublishOnly": "npm run compile",
    "test": "nyc mocha 'test/**/*.test.ts'",
    "tdd": "npm test -- --watch --watch-files \"**/*.ts\"",
    "watch": "tsdown --watch --no-clean"
  },
  "keywords": [
    "opentelemetry",
    "nodejs",
    "resources",
    "stats",
    "profiling"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/contrib-test-utils": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "bignumber.js": "9.3.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  },
  "dependencies": {
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/resources": "^3.0.0",
    "gcp-metadata": "^8.0.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/resource-detector-gcp#readme",
  "sideEffects": false
}
