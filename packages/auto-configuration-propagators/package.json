{
  "name": "@opentelemetry/auto-configuration-propagators",
  "version": "0.4.6",
  "description": "Metapackage which bundles known propagators for configuration via an env variable.",
  "author": "OpenTelemetry Authors",
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/auto-configuration-propagators#readme",
  "license": "Apache-2.0",
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/auto-configuration-propagators"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/auto-configuration-propagators",
    "prepublishOnly": "npm run compile",
    "tdd": "npm test -- --watch --watch-files \"**/*.ts\"",
    "test": "nyc mocha 'test/**/*.ts'",
    "watch": "tsdown --watch --no-clean"
  },
  "bugs": {
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib/issues"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.4.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.4.1"
  },
  "dependencies": {
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/propagator-aws-xray": "^2.2.0",
    "@opentelemetry/propagator-aws-xray-lambda": "^0.56.0",
    "@opentelemetry/propagator-b3": "^2.0.0",
    "@opentelemetry/propagator-ot-trace": "^0.29.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ]
}
