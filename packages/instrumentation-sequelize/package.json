{
  "name": "@opentelemetry/instrumentation-sequelize",
  "version": "0.15.0",
  "description": "OpenTelemetry instrumentation for `sequelize` ORM",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/instrumentation-sequelize"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/instrumentation-sequelize",
    "lint:readme": "node ../../scripts/lint-readme.js",
    "prepublishOnly": "npm run compile",
    "tdd": "yarn test -- --watch-extensions ts --watch",
    "test": "nyc --no-clean mocha --require '@opentelemetry/contrib-test-utils' 'test/**/*.test.ts'",
    "test-all-versions": "tav",
    "version:update": "node ../../scripts/version-update.js",
    "watch": "tsdown --watch --no-clean"
  },
  "keywords": [
    "sequelize",
    "instrumentation",
    "nodejs",
    "opentelemetry",
    "tracing"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.3.0",
    "@opentelemetry/contrib-test-utils": "^0.69.0",
    "@opentelemetry/sdk-trace": "^2.9.0",
    "@types/node": "18.18.14",
    "mysql2": "^3.11.5",
    "nyc": "17.1.0",
    "pg": "^8.7.1",
    "rimraf": "5.0.10",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "typescript": "5.0.4"
  },
  "dependencies": {
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.27.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/instrumentation-sequelize#readme"
}
