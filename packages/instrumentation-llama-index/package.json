{
  "name": "@opentelemetry/instrumentation-llama-index",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTelemetry instrumentation for the `llamaindex` LlamaIndex.TS library",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/instrumentation-llama-index"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/instrumentation-llama-index",
    "lint:readme": "node ../../scripts/lint-readme.js",
    "prepublishOnly": "npm run compile",
    "tdd": "npm run test -- --watch-extensions ts --watch",
    "test": "nyc --no-clean mocha --config .mocharc.js",
    "version:update": "node ../../scripts/version-update.js",
    "watch": "tsdown --watch --no-clean"
  },
  "keywords": [
    "instrumentation",
    "opentelemetry",
    "observability",
    "llamaindex",
    "llm",
    "genai"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/contrib-test-utils": "^0.71.0",
    "@types/mocha": "10.0.10",
    "@types/node": "22.17.1",
    "@types/sinon": "17.0.4",
    "mocha": "11.7.5",
    "nyc": "17.1.0",
    "rimraf": "5.0.10",
    "sinon": "15.2.0",
    "typescript": "5.0.4"
  },
  "dependencies": {
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.37.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/instrumentation-llama-index#readme"
}
