{
  "name": "@opentelemetry/sampler-aws-xray",
  "version": "0.4.0",
  "description": "OpenTelemetry Remote Sampler for AWS X-Ray",
  "keywords": [
    "aws",
    "sampler",
    "nodejs",
    "opentelemetry",
    "AWS",
    "X-Ray"
  ],
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/sampler-aws-xray#readme",
  "license": "Apache-2.0",
  "author": "OpenTelemetry Authors",
  "bugs": {
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib/issues"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/sampler-aws-xray"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/sampler-aws-xray",
    "prepublishOnly": "npm run compile",
    "tdd": "npm test -- --watch --watch-files \"**/*.ts\"",
    "test": "nyc mocha 'test/**/*.test.ts'",
    "version:update": "node ../../scripts/version-update.js",
    "watch": "tsdown --watch --no-clean"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.1.0"
  },
  "dependencies": {
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.27.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
