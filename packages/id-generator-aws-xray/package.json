{
  "name": "@opentelemetry/id-generator-aws-xray",
  "version": "3.0.0",
  "description": "AWS X-Ray ID generator for OpenTelemetry",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "imports": {
    "#platform": {
      "otel": {
        "node": "./src/platform/node/index.ts",
        "default": "./src/platform/browser/index.ts"
      },
      "node": {
        "require": "./dist/platform/node/index.cjs",
        "default": "./dist/platform/node/index.mjs"
      },
      "require": "./dist/platform/browser/index.cjs",
      "default": "./dist/platform/browser/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/id-generator-aws-xray"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/id-generator-aws-xray",
    "test": "nyc mocha 'test/**/*.test.ts' --exclude 'test/browser/**/*.test.ts'",
    "test:browser": "nyc karma start --single-run",
    "watch": "tsdown --watch --no-clean",
    "prepublishOnly": "npm run compile"
  },
  "keywords": [
    "opentelemetry",
    "nodejs",
    "browser",
    "tracing",
    "AWS",
    "X-Ray"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "dependencies": {
    "@opentelemetry/sdk-trace": "^3.0.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/id-generator-aws-xray#readme"
}
