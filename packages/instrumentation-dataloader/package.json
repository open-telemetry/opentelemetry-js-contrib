{
  "name": "@opentelemetry/instrumentation-dataloader",
  "version": "0.39.0",
  "description": "OpenTelemetry instrumentation for `dataloader` data fetching layer",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/instrumentation-dataloader"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/instrumentation-dataloader",
    "compile": "tsdown",
    "prepublishOnly": "npm run compile",
    "tdd": "npm test -- --watch --watch-files \"**/*.ts\"",
    "test": "nyc --no-clean mocha 'test/**/*.test.ts'",
    "test-all-versions": "tav",
    "version:update": "node ../../scripts/version-update.js"
  },
  "keywords": [
    "dataloader",
    "instrumentation",
    "nodejs",
    "opentelemetry",
    "profiling",
    "tracing"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.3.0",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@opentelemetry/contrib-test-utils": "^0.69.0",
    "@opentelemetry/sdk-trace": "^2.9.0",
    "dataloader": "2.2.3"
  },
  "dependencies": {
    "@opentelemetry/instrumentation": "^0.222.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/instrumentation-dataloader#readme"
}
