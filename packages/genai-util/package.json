{
  "name": "@opentelemetry/genai-util",
  "version": "0.1.0",
  "description": "Utilities for OpenTelemetry Generative AI instrumentations",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/genai-util",
    "compile": "tsdown",
    "prepublishOnly": "npm run compile",
    "test": "nyc mocha 'test/**/*.test.ts'",
    "watch": "tsc -w",
    "version:update": "node ../../scripts/version-update.js",
    "lint:readme": "node ../../scripts/lint-readme.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/genai-util"
  },
  "keywords": [
    "opentelemetry",
    "contrib",
    "genai",
    "ai",
    "llm",
    "instrumentation"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "bugs": {
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib/issues"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/genai-util#readme",
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "dependencies": {
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.27.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.3.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-trace": "^2.9.0"
  }
}
