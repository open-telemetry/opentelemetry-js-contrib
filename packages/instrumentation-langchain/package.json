{
  "name": "@opentelemetry/instrumentation-langchain",
  "version": "0.14.0",
  "private": true,
  "description": "OpenTelemetry instrumentation for the `langchain` LangChain.js library",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/instrumentation-langchain"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "lint:readme": "node ../../scripts/lint-readme.js",
    "prepublishOnly": "npm run compile",
    "tdd": "npm test -- --watch --watch-files \"**/*.ts\"",
    "test": "nyc --no-clean mocha 'test/**/*.test.ts' --require '@opentelemetry/contrib-test-utils'",
    "test-all-versions": "tav",
    "test:collector": "node test/collector/run.cjs",
    "version:update": "node ../../scripts/version-update.js",
    "watch": "tsdown --watch --no-clean"
  },
  "keywords": [
    "instrumentation",
    "opentelemetry",
    "observability",
    "langchain",
    "llm",
    "genai"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.0.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/contrib-test-utils": "^0.71.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.300.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "langchain": "^1.0.0"
  },
  "dependencies": {
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.37.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/instrumentation-langchain#readme"
}
