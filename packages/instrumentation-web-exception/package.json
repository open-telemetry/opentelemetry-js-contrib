{
  "name": "@opentelemetry/instrumentation-web-exception",
  "version": "0.17.0",
  "description": "OpenTelemetry instrumentation for web exceptions",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": "open-telemetry/opentelemetry-js-contrib",
  "scripts": {
    "clean": "rimraf dist build",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/instrumentation-web-exception",
    "compile": "tsdown",
    "prepublishOnly": "npm run compile",
    "prewatch": "npm run precompile",
    "tdd": "wtr --watch",
    "test:browser": "wtr --coverage",
    "version:update": "node ../../scripts/version-update.js",
    "watch": "tsdown --watch --no-clean"
  },
  "keywords": [
    "opentelemetry",
    "exception",
    "web",
    "tracing",
    "plugin",
    "browser",
    "error"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/chai": "^5.2.2",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/dev-server-rollup": "^1.0.0",
    "@web/test-runner": "^1.0.0",
    "chai": "^6.2.1"
  },
  "dependencies": {
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.27.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/plugins/web/opentelemetry-instrumentation-web-exception#readme"
}
