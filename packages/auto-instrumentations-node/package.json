{
  "name": "@opentelemetry/auto-instrumentations-node",
  "version": "0.82.0",
  "description": "Metapackage which bundles opentelemetry node core and contrib instrumentations",
  "author": "OpenTelemetry Authors",
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/auto-instrumentations-node#readme",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./register": {
      "require": {
        "types": "./dist/register.d.cts",
        "default": "./dist/register.cjs"
      },
      "default": {
        "types": "./dist/register.d.mts",
        "default": "./dist/register.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/auto-instrumentations-node"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/auto-instrumentations-node",
    "prepublishOnly": "npm run compile",
    "tdd": "npm test -- --watch --watch-files \"**/*.ts\"",
    "test": "nyc mocha 'test/**/*.ts'",
    "watch": "tsdown --watch --no-clean"
  },
  "bugs": {
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib/issues"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0"
  },
  "dependencies": {
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-amqplib": "^0.71.0",
    "@opentelemetry/instrumentation-aws-lambda": "^0.76.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.79.0",
    "@opentelemetry/instrumentation-bunyan": "^0.69.0",
    "@opentelemetry/instrumentation-cassandra-driver": "^0.69.0",
    "@opentelemetry/instrumentation-connect": "^0.67.0",
    "@opentelemetry/instrumentation-cucumber": "^0.40.0",
    "@opentelemetry/instrumentation-dataloader": "^0.41.0",
    "@opentelemetry/instrumentation-dns": "^0.67.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-fs": "^0.43.0",
    "@opentelemetry/instrumentation-generic-pool": "^0.67.0",
    "@opentelemetry/instrumentation-graphql": "^0.72.0",
    "@opentelemetry/instrumentation-grpc": "^0.300.0",
    "@opentelemetry/instrumentation-hapi": "^0.70.0",
    "@opentelemetry/instrumentation-host-metrics": "^0.7.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.33.0",
    "@opentelemetry/instrumentation-knex": "^0.68.0",
    "@opentelemetry/instrumentation-koa": "^0.72.0",
    "@opentelemetry/instrumentation-lru-memoizer": "^0.68.0",
    "@opentelemetry/instrumentation-memcached": "^0.67.0",
    "@opentelemetry/instrumentation-mongodb": "^0.77.0",
    "@opentelemetry/instrumentation-mongoose": "^0.70.0",
    "@opentelemetry/instrumentation-mysql": "^0.70.0",
    "@opentelemetry/instrumentation-mysql2": "^0.70.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.71.0",
    "@opentelemetry/instrumentation-net": "^0.68.0",
    "@opentelemetry/instrumentation-openai": "^0.22.0",
    "@opentelemetry/instrumentation-oracledb": "^0.49.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-redis": "^0.72.0",
    "@opentelemetry/instrumentation-restify": "^0.69.0",
    "@opentelemetry/instrumentation-router": "^0.68.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/instrumentation-socket.io": "^0.71.0",
    "@opentelemetry/instrumentation-tedious": "^0.43.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/instrumentation-winston": "^0.69.0",
    "@opentelemetry/resource-detector-alibaba-cloud": "^0.39.0",
    "@opentelemetry/resource-detector-aws": "^3.0.0",
    "@opentelemetry/resource-detector-azure": "^0.32.0",
    "@opentelemetry/resource-detector-container": "^0.9.0",
    "@opentelemetry/resource-detector-gcp": "^0.59.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ]
}
