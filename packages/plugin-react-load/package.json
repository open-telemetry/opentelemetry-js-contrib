{
  "name": "@opentelemetry/plugin-react-load",
  "version": "0.54.0",
  "description": "OpenTelemetry instrumentation for React class component lifecycle methods",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/plugin-react-load"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/plugin-react-load",
    "lint:readme": "node ../../scripts/lint-readme.js",
    "prepublishOnly": "npm run compile",
    "tdd": "karma start",
    "test:browser": "nyc karma start --single-run",
    "version:update": "node ../../scripts/version-update.js",
    "watch": "tsc --build --watch tsconfig.json tsconfig.esm.json tsconfig.esnext.json"
  },
  "keywords": [
    "opentelemetry",
    "react",
    "web",
    "tracing",
    "profiling",
    "plugin"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "@opentelemetry/propagator-b3": "^2.9.0",
    "@opentelemetry/sdk-trace": "^2.9.0",
    "@opentelemetry/sdk-trace-web": "^2.9.0",
    "@types/react": "17.0.91",
    "@types/react-addons-test-utils": "0.14.26",
    "@types/react-dom": "17.0.26",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0",
    "react": "^16.13.1 || ^17.0.0"
  },
  "dependencies": {
    "@opentelemetry/instrumentation": "^0.222.0",
    "shimmer": "^1.2.1"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/plugin-react-load#readme"
}
