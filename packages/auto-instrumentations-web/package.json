{
  "name": "@opentelemetry/auto-instrumentations-web",
  "version": "0.69.0",
  "description": "Metapackage which bundles opentelemetry node core and contrib instrumentations",
  "author": "OpenTelemetry Authors",
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/auto-instrumentations-web#readme",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/auto-instrumentations-web"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile": "tsdown",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/auto-instrumentations-web",
    "prepublishOnly": "npm run compile",
    "test:browser": "nyc karma start --single-run",
    "watch": "tsdown --watch --no-clean"
  },
  "bugs": {
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib/issues"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "zone.js": "^0.11.4 || ^0.13.0 || ^0.14.0 || ^0.15.0 || ^0.16.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "dependencies": {
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-document-load": "^0.69.0",
    "@opentelemetry/instrumentation-fetch": "^0.300.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.68.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.300.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ]
}
