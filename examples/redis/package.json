{
  "name": "redis-example",
  "private": true,
  "version": "0.1.0",
  "description": "Example of Redis integration with OpenTelemetry",
  "main": "index.js",
  "scripts": {
    "docker:start": "docker run -d -p 6379:6379 --name otel-redis redis:alpine",
    "docker:stop": "docker stop otel-redis && docker rm otel-redis",
    "server": "cross-env OTEL_SERVICE_NAME=example-http-server node --import ./telemetry.mjs lib/server.cjs",
    "client": "cross-env OTEL_SERVICE_NAME=example-http-client node --import ./telemetry.mjs lib/client.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/open-telemetry/opentelemetry-js.git"
  },
  "keywords": [
    "opentelemetry",
    "redis",
    "tracing"
  ],
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/open-telemetry/opentelemetry-js/issues"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.0.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-redis": "^0.70.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "axios": "^1.6.0",
    "express": "^5.1.0",
    "redis": "^6.2.1"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js/tree/main/examples/redis#readme",
  "devDependencies": {
    "@types/express": "^5.0.5",
    "cross-env": "^10.1.0"
  }
}
