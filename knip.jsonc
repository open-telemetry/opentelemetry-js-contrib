// https://knip.dev/reference/configuration
{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  "workspaces": {
    "packages/auto-instrumentations-node": {
      // Ensure register.ts is considered an entry-point (the `!` is to be
      // included with the `--production` flag).
      "entry": "src/register.ts!"
    },
    "packages/genai-util": {
      // Temporary ignore during foundation phase before handlers and invocations are added in follow-up PRs.
      // REMOVE this configuration once the exports and handlers are added to packages/genai-util/src/index.ts.
      "ignoreDependencies": [
        "@opentelemetry/core",
        "@opentelemetry/semantic-conventions"
      ]
    }
  }
}
